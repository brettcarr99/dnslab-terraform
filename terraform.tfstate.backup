    "test_commands": {
      "value": "# SSH into resolver:\nssh brettcarr@13.41.72.144\n\n# From the resolver, test full recursive chain:\ndig @127.0.0.1 www.example.lab A          # full recursive lookup\ndig @10.0.1.10 lab. NS              # root -\u003e TLD delegation\ndig @10.0.1.11 example.lab. NS      # TLD -\u003e 2LD delegation\ndig @10.0.1.12 www.example.lab. A   # 2LD authoritative answer\n\n# Check user-data progress on any node:\nsudo tail -f /var/log/user-data.log\n",
      "type": "string"
    }
  },
